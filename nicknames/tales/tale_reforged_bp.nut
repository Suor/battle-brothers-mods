// mode: campaign seed=bbtest-nick origin=scenario.militia fresh=1
// mods: mod_black_pyramid==1.4.4 mod_nicknames@dev mod_hooks stdlib@dev
// include: lib/helpers.nut

// Reforged + Black Pyramid (its elemental part needs Reforged; its beasts part the
// mods_* API of mod_hooks). The traits come from the real mod here, not relabelled vanilla ones.

local Fears = {"trait.elem_fear_fire": "the Singed", "trait.elem_fear_ice": "Shivers",
    "trait.elem_fear_thunder": "the Storm"};

test("Black Pyramid phobias reach the candidates", function (t) {
    ::NickT.resetState();
    t.eq([::Hooks.hasMod("mod_reforged"), ::Hooks.hasMod("mod_elemental_reforged")], [true, true], "mods loaded");
    local seen = {}, missing = [];
    for (local i = 0; i < 120; i++) {
        local bro = ::NickT.recruit(["farmhand_background", "daytaler_background", "militia_background"]);
        foreach (f, title in Fears) {
            if (!bro.getSkills().hasSkill(f)) continue;
            seen[f] <- true;
            if (!::NickT.has(::NickT.titles(bro), title)) missing.push(f + " -> " + title);
        }
    }
    ::World.getTemporaryRoster().clear();
    t.eq(::NickT.keys(seen), ::NickT.keys(Fears), "phobias met among 120 recruits");
    t.eq(missing, []);
});

// N5 at campaign start, not a bug: titles rolled before the mod runs are kept unchecked.
test("N5 report: repeated starting titles", function (t) {
    ::NickT.resetState();
    local seen = {}, dups = [];
    foreach (bro in t.roster()) {
        if (bro.m.Title in seen) dups.push(bro.m.Title);
        seen[bro.m.Title] <- true;
    }
    t.probe("repeated", dups);
    t.probe("generated by the mod", ::NickT.keys(::Nicknames.loadState().generated));
}, {needs = ["worldgen"]});
