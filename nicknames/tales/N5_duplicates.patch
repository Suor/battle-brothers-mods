+// A title rolled before the mod could check it (vanilla's or an origin's) is kept unless it's a duplicate
+local function wornByAnother(_bro) {
+    foreach (b in ::World.getPlayerRoster().getAll())
+        if (b.getID() != _bro.getID() && b.getTitle() == _bro.getTitle()) return true;
+    return false;
+}
